# Copy to .env for local runs. On Render, set these in the dashboard / Blueprint.

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Local SQLite (default) or Postgres
# DATABASE_URL=sqlite+aiosqlite:///./demsta.db
# DATABASE_URL=postgresql+asyncpg://demsta:demsta@localhost:5432/demsta
# Render injects DATABASE_URL as postgres://… — app normalizes to asyncpg + ssl=require

AUTO_MIGRATE=true
ENABLE_RLS=true

# Comma-separated or JSON list
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# FRONTEND_ORIGIN=https://demsta-web.onrender.com

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true

ALLOW_DEMO_RESEED=true
SEED_FORCE=false

OBJECT_STORAGE_PATH=./data/object_store
IMAGING_MAX_UPLOAD_BYTES=15728640
